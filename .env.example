# --- Your model (vLLM) ---
# Default setup: vLLM runs in WSL (outside Docker). The app container reaches it
# via host.docker.internal. Point this at your WSL server and match MODEL_NAME
# to the --served-model-name you passed to vLLM:
VLLM_BASE_URL=http://host.docker.internal:8002/v1
MODEL_NAME=Qwen3-4B
#
# If you instead use the optional dockerized vllm service (profile "docker-gpu"):
#   VLLM_BASE_URL=http://vllm:8000/v1
#
# The settings below are only used by the optional dockerized vllm service
# (profile "docker-gpu"). Ignored when running vLLM in WSL.
# Option A — local HF-format folder: MODEL_DIR=D:/models/Qwen3-4B-AWQ, VLLM_MODEL=/models
# Option B — auto-download from HuggingFace: VLLM_MODEL=Qwen/Qwen3-4B-AWQ (MODEL_DIR unused)
MODEL_DIR=C:/models/my-model
VLLM_MODEL=/models
# Max context length — keep modest so everything fits in VRAM
MAX_MODEL_LEN=8192

# --- Research budgets (keep it light) ---
MAX_ITEMS_PER_SOURCE=30
MAX_CHARS_PER_ITEM=1500
FETCH_TIMEOUT_SECONDS=15
CACHE_TTL_HOURS=6
LOOKBACK_DAYS=7
SHORTLIST_SIZE=8

# --- Weekly schedule (container time) ---
SCHEDULER_DAY_OF_WEEK=mon
SCHEDULER_HOUR=6
